class Solution {
    static boolean ans;
    public boolean isBipartite(int[][] graph) {
        int[] vis = new int[graph.length];
        ans = true;
        Arrays.fill(vis, -1);
        for (int i=0; i<graph.length; i++) {
            if(vis[i] == -1) {
                dfs(i, vis, graph);
            }
        }
        return ans;
    }
    public void dfs(int i, int[] vis, int[][] graph) {
        vis[i] = 1;
        Queue<Integer> q = new LinkedList<>();
        q.add(i);
        while (q.size() >0) {
            int top = q.remove();
            for (int ele: graph[top]) {
                if (vis[ele] == -1) {
                    vis[ele] = 1-vis[top];
                    q.add(ele);
                }
                else if(vis[ele] == vis[top]) {
                    ans = false;
                    return;
                }
            }
        }
    }
}